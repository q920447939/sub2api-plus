# =============================================================================
# Sub2API Plus — Development Environment Variables
# =============================================================================
# 使用方式（从仓库根目录运行）：
#   docker compose -f deploy/docker-compose.plus-dev.yml --env-file deploy/.env.plus-dev up --build -d
#
# 注意：此文件包含本地开发用的占位密码，不适合生产环境。
# =============================================================================

# 数据库
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=sub2api_plus_dev

# Redis（本地开发不需要密码）
REDIS_PASSWORD=

# 管理员账号（首次启动自动创建）
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Dev123456!

# JWT（本地开发用随机字符串即可；生产必须换）
JWT_SECRET=local-dev-jwt-secret-please-change

# TOTP 加密密钥（留空则每次启动随机生成，本地开发可接受）
TOTP_ENCRYPTION_KEY=

# 时区
TZ=Asia/Shanghai
