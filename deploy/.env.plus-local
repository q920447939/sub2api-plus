# =============================================================================
# 本地构建测试用的环境变量 — 不要用于生产，不要提交到 git
# =============================================================================
# 使用方式：
#   docker compose -f deploy/docker-compose.plus-local.yml --env-file deploy/.env.plus-local up --build -d

# 数据库
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=local_test_password
POSTGRES_DB=sub2api_plus

# Redis（本地测试不需要密码）
REDIS_PASSWORD=

# 管理员账号（首次启动自动创建）
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin123456!

# JWT（本地测试用随机字符串即可；生产必须换）
JWT_SECRET=local-dev-jwt-secret-please-change

# 时区
TZ=Asia/Shanghai
